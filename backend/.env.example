# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-this-to-a-long-random-string-50-chars-minimum
DJANGO_DEBUG=True

# ── Google Cloud ───────────────────────────────────────────────────────────────
# Download your service account JSON from https://console.cloud.google.com/iam-admin/serviceaccounts
# Enable: Cloud Speech-to-Text API, Cloud Translation API, Cloud Text-to-Speech API
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\your\service-account.json

# ── YouTube Data API (optional — used for video discovery) ────────────────────
# YOUTUBE_API_KEY=your-youtube-data-api-v3-key
